{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStream",
  "version": "0.1.0",
  "identifier": "app.openstream.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ./ui dev",
    "beforeBuildCommand": "pnpm --dir ./ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenStream",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      },
      "wix": null
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-0", "libxdo0"],
        "section": "net",
        "priority": "optional"
      },
      "rpm": {
        "depends": ["gtk3", "webkit2gtk4.1", "libappindicator-gtk3", "librsvg2", "libxdo"]
      }
    }
  }
}
